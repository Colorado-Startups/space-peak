---
// A figure from the claims register: its value, then a small "source" link when the row has a source.
// <Figure claim="S-04" /> or <Figure claim="S-04" value="14,053 ft" />. data-claim is for checks, never shown.
import "../styles/figure.css";
import { figureView } from "./figure";

interface Props {
  claim: string;
  value?: string;
}

const { claim, value } = Astro.props;
const fig = figureView(claim, value);
---
<span class="figure" data-claim={fig.id}>
  <span class="figure-value">{fig.value}</span>
  {fig.href && <a class="figure-source" href={fig.href} rel="noopener">source</a>}
</span>
