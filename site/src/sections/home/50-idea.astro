---
// Home section 5, "The big idea" (step 36, issue #140): what a kg to orbit has cost, then an altitude ruler for the
// speculative muzzle. Every number is read out of its claims-register row, so the build stops if a row stops saying
// it. The ruler rises once on first view (public/js/ruler-rise.js); with no script, or under reduced motion, it is drawn.
import Chart from "../../components/charts/Chart.astro";
import Figure from "../../components/Figure.astro";
import { chipFor, sourceOf } from "../../components/figure";
import { getClaim } from "../../lib/claims/parse";
import type { ChartSpec } from "../../lib/charts/plot";

/** A row's own words matched against `re`; the build stops if the row no longer says it. */
function said(id: string, re: RegExp): RegExpExecArray {
  const m = re.exec(getClaim(id).claim);
  if (!m) throw new Error(`50-idea: ${id} no longer matches ${re}: ${getClaim(id).claim}`);
  return m;
}
const num = (s: string) => Number(s.replace(/,/g, ""));

// The four systems NASA's report costs itself (Table A2), and its 1970 to 2000 average, in first-flight order.
const COST = [["E-06", "Saturn V"], ["E-07", "Average"], ["E-08", "Space shuttle"], ["E-09", "Falcon 9"], ["E-10", "Falcon Heavy"]];
const bars = COST.map(([claim, name]) => {
  const [, dollars] = said(claim, /\$([\d,]+) per kg/);
  const [, from, to, year] = said(claim, /(\d{4}) to (\d{4})|in (\d{4})/);
  return { claim, label: `${name}, ${year ?? `${from} to ${to}`}`, value: num(dollars) };
});
const cost: ChartSpec = {
  kind: "bar",
  title: "Launch cost per kg to low Earth orbit, in 2018 dollars, per NASA",
  unit: "USD per kg",
  rows: bars.map(({ label, value }) => ({ label, value })),
};
const statuses = [...new Set(bars.map((b) => getClaim(b.claim).status))];
const source = sourceOf(getClaim("E-06").source);
if (!source?.url || bars.some((b) => sourceOf(getClaim(b.claim).source)?.url !== source.url)) throw new Error("50-idea: the cost rows no longer share one source");

// The ruler, each value in its row's words, "about" kept where the row has it.
const [, low, high] = said("P-02", /([\d,]+) to ([\d,]+) ft/);
const [, airAbout, airLow, airHigh] = said("P-02", /(about )?(\d+) to (\d+) percent/);
const [, pikes] = said("S-14", /([\d,]+) ft/);
const [, orbitAbout, orbit] = said("P-01", /(about )?([\d,]+) mph sideways/);
const KEY = [
  { mark: "orbit", label: "Orbit", claim: "P-01", value: `${orbitAbout ?? ""}${orbit} mph sideways` },
  { mark: "pikes", label: "Pikes Peak", claim: "S-14", value: `${pikes} ft` },
  { mark: "muzzle", label: "Muzzle", claim: "P-02", value: `${low}–${high} ft`, speculative: true },
  { mark: "air", label: "Air below", claim: "P-02", value: `${airAbout ?? ""}${airLow}–${airHigh}%` },
];

// Side view in a 360 by 420 box: sea level at y 400, 15,000 ft at y 100, orbit above a break in the scale.
const [AXIS, GROUND, TOP] = [80, 400, 15000];
const y = (ft: number) => GROUND - (ft / TOP) * 300;
const PEAK_X = 232;
const TICKS = [0, 5000, 10000, 15000];
---
<section class="idea" aria-labelledby="idea-title">
  <h2 id="idea-title">The big idea</h2>
  <p class="idea-lead">Cost to orbit is the choke point.</p>
  <div class="idea-body">
    <div class="idea-cost" data-claims={bars.map((b) => b.claim).join(" ")}>
      <Chart spec={cost} caption="2018 dollars per kg to low Earth orbit" />
      <p class="idea-source">
        <span><a href={source.url}>NASA</a>, costed in 2018</span>
        {statuses.map((s) => <span class={chipFor(s).className}>{chipFor(s).word}</span>)}
      </p>
    </div>
    <figure class="ruler" data-rise="">
      <svg viewBox="0 0 360 420" role="img" aria-labelledby="ruler-title ruler-desc" font-size="15">
        <title id="ruler-title">Altitude ruler, the muzzle speculative</title>
        <desc id="ruler-desc">Side view from sea level. A hatched band marks the muzzle height the brief proposes, just under Pikes Peak's summit. Above a break in the scale, an arrow points sideways: orbit is a speed, not a height. The key gives each value with its register status.</desc>
        <defs>
          <pattern id="idea-hatch" width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <rect width="6" height="12" fill="var(--co-yellow)" />
          </pattern>
        </defs>
        {TICKS.map((ft) => (
          <g>
            <line x1={AXIS - 8} y1={y(ft)} x2={AXIS} y2={y(ft)} stroke="var(--c-text)" stroke-width="2" />
            <text x={AXIS - 12} y={y(ft)} text-anchor="end" dominant-baseline="middle" fill="var(--c-text-dim)">{ft === 0 ? "0 ft" : ft.toLocaleString("en-US")}</text>
          </g>
        ))}
        <path d={`M${AXIS} ${GROUND}V${y(TOP) - 4}M${AXIS} ${y(TOP) - 20}V40`} stroke="var(--c-text)" stroke-width="2" />
        <path d={`M${AXIS - 8} ${y(TOP) - 2}l16 -8M${AXIS - 8} ${y(TOP) - 14}l16 -8`} stroke="var(--c-text)" stroke-width="2" />
        <line x1={AXIS} y1={GROUND} x2="352" y2={GROUND} stroke="var(--c-text-dim)" stroke-width="2" />
        <g class="ruler-rise">
          <rect data-mark="muzzle" x={AXIS + 4} y={y(num(high))} width={348 - AXIS} height={y(num(low)) - y(num(high))} fill="url(#idea-hatch)" stroke="var(--c-text)" stroke-width="2" />
          <polygon data-mark="pikes" points={`${AXIS + 8},${GROUND} ${PEAK_X},${y(num(pikes))} 352,${GROUND}`} fill="var(--c-surface-2)" fill-opacity="0.85" stroke="var(--c-text-dim)" stroke-width="2" />
          <line x1={AXIS} y1={y(num(pikes))} x2={PEAK_X} y2={y(num(pikes))} stroke="var(--c-text)" stroke-width="2" stroke-dasharray="4 6" />
          <circle cx={PEAK_X} cy={y(num(pikes))} r="5" fill="var(--c-text)" />
          <path data-mark="orbit" d={`M${AXIS + 12} 40H322`} stroke="var(--c-text)" stroke-width="4" stroke-dasharray="2 10" stroke-linecap="round" />
          <polygon points="322,29 344,40 322,51" fill="var(--c-text)" />
        </g>
        <g class="ruler-labels" fill="var(--c-text)" paint-order="stroke" stroke="var(--c-ground)" stroke-width="5" stroke-linejoin="round">
          <text x={AXIS + 12} y="22">orbit, sideways</text>
          <text x={PEAK_X + 12} y={y(num(pikes)) - 8}>Pikes Peak</text>
          <text x={AXIS + 16} y={(y(num(high)) + y(num(low))) / 2} dominant-baseline="middle" font-style="italic" font-weight="700">muzzle, speculative</text>
        </g>
      </svg>
      <ul class="ruler-key">
        {KEY.map((k) => (
          <li data-mark={k.mark}>
            <details>
              <summary>
                <span class="ruler-label">{k.label}{k.speculative && <span class="hatch-tag">speculative</span>}</span>
                <Figure claim={k.claim} value={k.value} />
              </summary>
            </details>
          </li>
        ))}
      </ul>
    </figure>
  </div>
  <script is:inline src="/js/ruler-rise.js" defer></script>
</section>

<style>
  .idea { margin-block: var(--s-8) 0; }
  .idea-lead { font-size: var(--t-step-1); }
  .idea-body { display: grid; gap: var(--s-7); align-items: start; }
  .idea-source { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-2); margin-block-start: var(--s-3); font-size: var(--t-step--1); }
  .ruler { margin: 0; display: grid; gap: var(--s-4); }
  .ruler svg { display: block; inline-size: 100%; max-inline-size: calc(var(--s-9) * 4); block-size: auto; }
  .ruler-key { display: grid; gap: var(--s-2); margin: 0; padding: 0; list-style: none; max-width: none; }
  .ruler-key details { border-inline-start: var(--size-ledge) solid var(--c-rule); }
  .ruler-key li[data-mark="muzzle"] details { border-inline-start-color: var(--co-yellow); }
  .ruler-key summary { position: relative; display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-1) var(--s-3); padding-inline: var(--s-3) var(--s-6); cursor: pointer; list-style: none; }
  .ruler-key summary::-webkit-details-marker { display: none; }
  /* A drawn chevron, not text, says it opens, as on the place tiles. */
  .ruler-key summary::after { content: ""; position: absolute; inset-block-start: var(--s-3); inset-inline-end: var(--s-3); width: 0.5em; height: 0.5em; border-inline-end: var(--line-bold) solid currentColor; border-block-end: var(--line-bold) solid currentColor; transform: rotate(45deg); }
  .ruler-key details[open] summary::after { transform: rotate(-135deg); }
  /* The register's source for each value waits for the press. :global, because <Figure>'s span carries its own scope, not this one. */
  .ruler-key details:not([open]) :global(.figure-source) { display: none; }
  .ruler-label { display: inline-flex; align-items: baseline; gap: var(--s-2); font-weight: 700; }
  /* The speculative hatch, as on an unverified chip (styles/figure.css). */
  .hatch-tag {
    padding: 0.1em 0.55em; border: var(--line-edge) solid var(--c-text); border-radius: var(--r-chisel);
    background: repeating-linear-gradient(-45deg, var(--co-yellow) 0 0.3em, var(--c-ground) 0.3em 0.6em);
    color: var(--c-ink); font-size: var(--t-step--1); text-shadow: 0 0 0.2em var(--c-ground), 0 0 0.2em var(--c-ground);
  }
  /* Drawn at rest. The script sets "wait" only below the fold and with motion allowed, then "go" once in view. */
  .ruler-rise { transform-box: fill-box; transform-origin: 50% 100%; }
  .ruler[data-rise="wait"] .ruler-rise { transform: scaleY(0); }
  .ruler[data-rise="wait"] .ruler-labels { opacity: 0; }
  /* 1.1 s of rise, then the labels in 0.3 s: 1.4 s in all, under the 1.5 s limit. Transform and opacity only. */
  .ruler[data-rise="go"] .ruler-rise { animation: ruler-rise 1.1s cubic-bezier(0.3, 0, 0.2, 1) both; }
  .ruler[data-rise="go"] .ruler-labels { animation: ruler-fade 0.3s ease-out 1.1s both; }
  @keyframes ruler-rise { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes ruler-fade { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .ruler[data-rise] .ruler-rise { transform: none; } .ruler[data-rise] .ruler-labels { opacity: 1; } }
  @media (min-width: 64rem) { .idea-body { grid-template-columns: 3fr 2fr; } }
</style>
