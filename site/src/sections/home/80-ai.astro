---
import { liveLinks } from "../../lib/nav";
const ai = liveLinks().find((link) => link.href === "/ai/");
const tiles = [
  { name: "Paste a URL", line: "Any AI that reads links can read this site." },
  { name: "Claude", line: "Ask Claude about Space Peak." },
  { name: "OpenCode", line: "Ask OpenCode about Space Peak." },
];
---
<section class="ai" aria-labelledby="ai-title">
  <h2 id="ai-title">Use it with your AI</h2>
  <ul class="tiles">
    {tiles.map((t) => <li><h3>{t.name}</h3><p>{t.line}</p></li>)}
  </ul>
  {ai && <a class="button" href={ai.href}>How it works</a>}
</section>

<style>
  .ai { margin-block-end: var(--s-7); }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--s-4); max-width: none; padding: 0; margin-block: 0 var(--s-5); list-style: none; }
  .tiles li { padding: var(--s-5); border-radius: var(--r-card); border-top: var(--line-bold) solid var(--c-region-space-peak); background: var(--c-surface); }
  .tiles p { margin: 0; }
</style>
