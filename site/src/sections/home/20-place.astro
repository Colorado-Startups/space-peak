---
// Home section 2, "The place" (step 25, issue #128): the region drawing that /maps/region.svg serves, beside
// 3 tiles. Each tile's number is read out of its claims-register row and shown through <Figure>, with the
// loop file's "source" link; the build stops if a row no longer states its number. No script.
import Figure from "../../components/Figure.astro";
import { getClaim } from "../../lib/claims/parse";
import { frame } from "../../lib/map/draw";

const TILES = [
  { claim: "R-03", unit: "sq mi", show: (n: string) => `${n} sq mi`, label: "inside the loop" },
  { claim: "R-04", unit: "mi", show: (n: string) => `${n} mi`, label: "widest span" },
  { claim: "R-05", unit: "times", show: (n: string) => `${n}×`, label: "Silicon Valley's loop" },
];
const tiles = TILES.map(({ claim, unit, show, label }) => {
  const row = getClaim(claim);
  const n = new RegExp(`(\\d+(?:\\.\\d+)?) ${unit}\\b`).exec(row.claim)?.[1];
  if (!n) throw new Error(`20-place: ${claim} no longer says "<number> ${unit}": ${row.claim}`);
  return { claim, label, value: show(n) };
});
const { width, height } = frame("region");
---
<section class="place" aria-labelledby="place-title">
  <h2 id="place-title">The place</h2>
  <div class="place-body">
    <img class="place-map" src="/maps/region.svg" alt="Drawing of the Colorado Startups region loop around Colorado Springs and Fountain, with Pikes Peak and local organisations." width={width} height={height} loading="lazy" decoding="async" />
    <ul class="place-tiles">
      {tiles.map(({ claim, label, value }) => (
        <li><Figure claim={claim} value={value} /><span class="place-label">{label}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .place { margin-block: var(--s-8) 0; }
  .place-body { display: grid; gap: var(--s-5); align-items: start; }
  .place-map { display: block; width: 100%; max-width: 32rem; height: auto; border: var(--line-hair) solid var(--c-rule); }
  .place-tiles { display: grid; gap: var(--s-3); margin: 0; padding: 0; list-style: none; max-width: none; }
  .place-tiles li { display: grid; gap: var(--s-1); padding: var(--s-4) var(--s-5); border: var(--line-hair) solid var(--c-rule); border-inline-start: var(--size-ledge) solid var(--c-region-space-peak); border-radius: var(--r-chisel); }
  /* <Figure> is its own component, so its value is reached with :global. */
  .place-tiles :global(.figure-value) { font-family: var(--font-display); font-size: var(--t-step-4); line-height: 1; }
  .place-label { font-weight: 700; }
  @media (min-width: 48rem) {
    .place-body { grid-template-columns: minmax(0, 1fr) minmax(0, 20rem); }
  }
</style>
