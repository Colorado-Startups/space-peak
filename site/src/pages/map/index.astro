---
// /map/: the drawing, its key and its list twin. Step 27 adds a "Live map" button to .map-actions.
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PlaceList from "../../components/map/PlaceList.astro";
import SpaceMap from "../../components/map/SpaceMap.astro";
import { loadMapData } from "../../lib/map/data";
import { frame } from "../../lib/map/draw";

const all = await loadMapData();
const [region, south] = [frame("region"), frame("south")];
// List exactly what the drawing shows: an org outside both views is drawn nowhere, so it is not listed.
const data = { ...all, orgs: all.orgs.filter((o) => region.inside(o.at) || south.inside(o.at)) };
const cities = new Map((await getCollection("orgs")).map((e) => [e.data.id, e.data.city as string]));
---
<Base title="Map | Space Peak" description="The Colorado Startups region, the four summits on the Space Peak tour, and the organisations near them.">
  <h1>The map</h1>
  <p>The region around Colorado Springs, the four speculative summits, and who works nearby.</p>
  <div class="map-actions"><a class="button" href="#places">Jump to the list</a></div>
  <SpaceMap data={data} />
  <PlaceList data={data} cities={cities} />
</Base>
