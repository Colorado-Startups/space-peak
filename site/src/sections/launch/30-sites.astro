---
// The site tour (step 35): the brief's ranked three, best first, then Pikes Peak as the name and headquarters.
// Every value is a register row through <Figure>, in SiteCard. The locator is /maps/south.svg, the map's own
// drawing of the tour (lib/map/draw.ts); this section draws no map.
import SiteCard from "../../components/launch/SiteCard.astro";
import { launch } from "../../lib/launch/data";
import { TOUR } from "../../lib/map/data";
import { frame } from "../../lib/map/draw";

const { ranked, headquarters } = launch().sites;
const { width, height } = frame("south");
---
<section aria-labelledby="sites">
  <h2 id="sites">The sites</h2>
  <div class="sites-body">
    <figure class="sites-map">
      <img src="/maps/south.svg" alt={`Map of the summits on the tour, each speculative: ${TOUR.join(", ")}.`} width={width} height={height} loading="lazy" decoding="async" />
      <figcaption>Tunnel through Greenhorn, headquarters on Pikes.</figcaption>
    </figure>
    <div class="sites-ranking">
      <p id="sites-ranking">Ranked, best first.</p>
      <ol class="sites-ranked" aria-labelledby="sites-ranking">
        {ranked.map((p) => <li class="site-card" data-site={p.site}><SiteCard place={p} /></li>)}
      </ol>
    </div>
  </div>
  <div class="site-card site-card--hq" data-site={headquarters.site}>
    <p class="site-tag">The name and headquarters</p>
    <SiteCard place={headquarters} />
  </div>
</section>

<style>
  .sites-body { display: grid; gap: var(--s-5); align-items: start; }
  .sites-map { margin: 0; display: grid; gap: var(--s-2); }
  .sites-map img { display: block; inline-size: 100%; max-inline-size: 32rem; block-size: auto; border: var(--line-hair) solid var(--c-rule); }
  figcaption { color: var(--c-text-dim); font-size: var(--t-step--1); }
  .sites-ranking { display: grid; gap: var(--s-3); }
  .sites-ranking > p { margin: 0; font-weight: 700; }
  .sites-ranked { counter-reset: rank; display: grid; gap: var(--s-4); margin: 0; padding: 0; list-style: none; max-width: none; }
  .site-card { padding: var(--s-4); border: var(--line-hair) solid var(--c-rule); border-inline-start: var(--line-bold) solid var(--c-region-space-peak); border-radius: var(--r-card); }
  /* The rank is drawn, not written: a numeral from a CSS counter. The list's own order says it to a screen reader. */
  .sites-ranked .site-card { counter-increment: rank; }
  .sites-ranked :global(h3)::before {
    content: counter(rank); display: inline-grid; place-items: center; flex: none; inline-size: var(--size-tap); block-size: var(--size-tap);
    margin-inline-end: var(--s-3); border: var(--line-bold) solid var(--c-text); border-radius: 50%;
  }
  .site-card--hq { margin-block: var(--s-5) var(--s-7); border-inline-start-style: dashed; }
  .site-tag { margin: 0 0 var(--s-2); color: var(--c-text-dim); font-size: var(--t-step--1); font-weight: 700; }
  @media (min-width: 64rem) { .sites-body { grid-template-columns: 2fr 3fr; } }
</style>
