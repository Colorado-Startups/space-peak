---
import "../styles/index.css";
import { Font } from "astro:assets";
import HeadMeta from "../components/HeadMeta.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const { title, description, jsonld } = Astro.props as { title: string; description: string; jsonld?: import("../lib/jsonld").Node[] };
---
<html lang="en">
  <head><HeadMeta title={title} description={description} jsonld={jsonld} /><Font cssVariable="--font-display" preload /><Font cssVariable="--font-body" preload /></head>
  <body><a class="skip-link" href="#main">Skip to content</a><Header /><main id="main"><slot /></main><Footer /></body>
</html>
